NODE_ENV=production
PORT=3000

# Use Compose service names, not localhost, for containers on the internal network.
DATABASE_URL=postgres://<user>:<password>@postgres:5432/<db>
REDIS_URL=redis://redis:6379

CACHE_TTL_AGENT_SECONDS=300
CACHE_TTL_LIST_SECONDS=60

# Optional comma-separated browser origins. Usually not needed with a frontend server-side rewrite.
CORS_ORIGINS=
