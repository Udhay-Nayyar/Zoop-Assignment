# HTTP server
PORT=3000
NODE_ENV=development

# Local defaults match the root docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/delivery_agents
REDIS_URL=redis://localhost:6379

# Agent cache lifetime in seconds
CACHE_TTL_AGENT_SECONDS=300
# Agent-list cache lifetime in seconds
CACHE_TTL_LIST_SECONDS=60
